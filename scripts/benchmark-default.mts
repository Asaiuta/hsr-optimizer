import assert from 'node:assert/strict'
import { execFile } from 'node:child_process'
import { createHash } from 'node:crypto'
import {
  readFile,
  writeFile,
} from 'node:fs/promises'
import {
  cpus,
  totalmem,
} from 'node:os'
import { resolve } from 'node:path'
import { promisify } from 'node:util'
import { chromium } from 'playwright'
import { preview } from 'vite'

const output = resolve(process.argv[2] ?? 'output/default-account-20261003')
const requestedIds = process.argv[3]?.split(',')
const budgetSeconds = Number(process.argv[4] ?? 120)
const rounds = Number(process.argv[5] ?? 3)
assert.ok(Number.isFinite(budgetSeconds) && budgetSeconds > 0)
assert.ok(Number.isInteger(rounds) && rounds > 0)
const reportName = requestedIds ? `report-${requestedIds.join('-')}-${budgetSeconds}s.json` : 'report.json'
const input = await readFile(`${output}/default-save.json`, 'utf8')
const plan = JSON.parse(await readFile(`${output}/plan.json`, 'utf8'))
const ordered = plan.plans.filter((p: any) => p.permutations > 0).sort((a: any, b: any) => a.permutations - b.permutations)
// Count all characters first; sample the smallest, smallest fully equipped, median,
// largest and three previous benchmark characters without changing their settings.
const selected = requestedIds ?? [
  ...new Set([ordered[0].characterId, '1104', '1310b1', '1407', ordered[Math.floor(ordered.length / 2)].characterId, '1512', ordered.at(-1).characterId]),
]
const report: Record<string, any> = {
  timestamp: new Date().toISOString(),
  engine: 'GPU Stable',
  resultsLimit: 1024,
  perTaskBudgetMs: budgetSeconds * 1000,
  rounds,
  defaultSaveSha256: createHash('sha256').update(input).digest('hex'),
  environment: { node: process.version, cpu: cpus()[0].model, logicalCpus: cpus().length, memoryBytes: totalmem() },
  selected,
  tasks: [],
  errors: [],
  notes: [
    'Original defaults generated by getDefaultForm; only scanned identity, eidolon and light cone retained.',
    'Isolated build adds a benchmark start entry to bypass the public API 100-result limit; same underlying optimizer, no phase probes.',
    'Selected characters and rounds recorded above; stop repeats after a timeout/failure. Other defaults only counted, not executed.',
    'Observation budget is not an optimizer limit. Timed-out tasks are cancelled and never reported as completed.',
    'The UI searched counter excludes warmup display offsets; it is not a raw global evaluated-combination counter.',
    'Page polls every 100ms; main renderer memory sampled every 15s and OS processes at task boundaries. No GPU kernel timing.',
    'Fresh browser per character, repeated tasks share that browser. Disk/driver shader caches are not cleared.',
  ],
}
async function checkpoint() {
  await writeFile(`${output}/${reportName}`, JSON.stringify(report, null, 2))
}
const server = await preview({
  configFile: 'vite.config.ts',
  build: { outDir: `${output}/site` },
  preview: { host: '127.0.0.1', port: 4175, strictPort: true, open: false },
})
try {
  for (const characterId of selected) {
    const expected = ordered.find((p: any) => p.characterId === characterId)
    const browser = await chromium.launch({ channel: 'msedge', headless: true })
    const page = await browser.newPage()
    const cdp = await page.context().newCDPSession(page)
    const rootCdp = await browser.newBrowserCDPSession()
    const pageErrors: string[] = []
    page.on('pageerror', (error) => pageErrors.push(error.message))
    await cdp.send('Performance.enable')
    async function heap() {
      const result = await cdp.send('Performance.getMetrics')
      return Object.fromEntries(
        result.metrics.filter((m) => ['JSHeapUsedSize', 'JSHeapTotalSize', 'TaskDuration'].includes(m.name)).map((m) => [m.name, m.value]),
      )
    }
    async function processes() {
      const { processInfo } = await rootCdp.send('SystemInfo.getProcessInfo')
      const os = await promisify(execFile)('powershell.exe', [
        '-NoProfile',
        '-NonInteractive',
        '-Command',
        `Get-Process | Where-Object { $_.Id -in @(${
          processInfo.map((p) => p.id).join(',')
        }) } | Select-Object Id,WorkingSet64,PeakWorkingSet64,PrivateMemorySize64,CPU | ConvertTo-Json -Compress`,
      ], { windowsHide: true })
      return { roles: processInfo, memory: JSON.parse(os.stdout), heap: await heap() }
    }
    try {
      await page.goto('http://127.0.0.1:4175/hsr-optimizer/')
      await page.waitForFunction(() => !!window.hsrAutomation && !!(window as any).__defaultBenchmark)
      const imported = await page.evaluate((json) => window.hsrAutomation.call('import_save', { json }), input)
      assert.ok(imported.ok, JSON.stringify(imported))
      const settings = await page.evaluate((id) => (window as any).__defaultBenchmark.inspect(id), characterId)
      for (
        const key of [
          'enhance',
          'grade',
          'rankFilter',
          'rank',
          'includeEquippedRelics',
          'keepCurrentRelics',
          'mainStatUpscaleLevel',
          'mainBody',
          'mainFeet',
          'mainPlanarSphere',
          'mainLinkRope',
          'setFilters',
          'resultsLimit',
          'resultSort',
          'statFilters',
          'weights',
          'comboTurnAbilities',
        ]
      ) {
        assert.deepEqual(settings[key], expected.resolved[key], `Browser default mismatch: ${characterId}/${key}`)
      }
      const gpu = await page.evaluate(async () => {
        const adapter = await navigator.gpu?.requestAdapter()
        return adapter ? { vendor: adapter.info.vendor, architecture: adapter.info.architecture } : null
      })
      assert.ok(gpu, 'GPU Stable requires WebGPU')
      for (let iteration = 0; iteration < rounds; iteration++) {
        const task: Record<string, any> = {
          characterId,
          name: expected.name,
          iteration,
          expectedPermutations: expected.permutations,
          gpu,
          settings,
          before: await processes(),
          samples: [],
          pageErrors,
        }
        report.tasks.push(task)
        const start = performance.now()
        const submitted = await page.evaluate((id) => (window as any).__defaultBenchmark.start(id), characterId)
        task.submitMs = performance.now() - start
        task.jobId = submitted.jobId
        await checkpoint()
        let nextSample = 15000
        while (true) {
          const response = await page.evaluate((jobId) => window.hsrAutomation.call('get_job', { jobId }), task.jobId) as any
          assert.ok(response.ok, JSON.stringify(response))
          task.elapsedMs = performance.now() - start
          task.lastStatus = response.data
          if (response.data.permutations !== undefined) assert.equal(response.data.permutations, expected.permutations, 'Live permutation count mismatch')
          if (response.data.status !== 'running') {
            task.outcome = response.data.status
            break
          }
          if (task.elapsedMs >= nextSample) {
            task.samples.push({ elapsedMs: task.elapsedMs, status: response.data, heap: await heap() })
            nextSample += 15000
            await checkpoint()
            process.stderr.write(`${characterId} #${iteration}: ${(task.elapsedMs / 1000).toFixed(1)}s, ${response.data.searched}/${expected.permutations}\n`)
          }
          if (task.elapsedMs >= report.perTaskBudgetMs) {
            const cancelled = await page.evaluate((jobId) => window.hsrAutomation.call('cancel_job', { jobId }), task.jobId)
            task.outcome = 'budget-exhausted'
            task.cancellation = cancelled
            break
          }
          await new Promise((resolve) => setTimeout(resolve, 100))
        }
        task.after = await processes()
        if (task.outcome === 'completed') {
          task.results = []
          for (let offset = 0; offset < task.lastStatus.resultCount; offset += 100) {
            const response = await page.evaluate(({ jobId, offset }) => window.hsrAutomation.call('get_results', { jobId, offset, limit: 100 }), {
              jobId: task.jobId,
              offset,
            }) as any
            assert.ok(response.ok)
            task.results.push(...response.data.results)
          }
          assert.equal(task.results.length, task.lastStatus.resultCount)
          assert.ok(task.results.length <= 1024)
          // Validate all retained results outside the timed search interval.
          task.verification = await page.evaluate(async ({ characterId, results }) => {
            let maximum = 0
            for (const row of results) {
              const response = await window.hsrAutomation.call('simulate_build', { characterId, relicIds: Object.values(row.relics) }) as any
              if (!response.ok) throw Error(JSON.stringify(response))
              for (const [key, value] of Object.entries(row.stats)) {
                // Search indices and inventory weights are not simulation outputs.
                if (key === 'id' || key === 'WEIGHT') continue
                const score = value as number
                const error = Math.abs(response.data.stats[key] - score) / Math.max(1, Math.abs(score))
                if (!Number.isFinite(error) || error >= 1e-5) throw Error(`Result mismatch for ${key}: ${error}`)
                maximum = Math.max(maximum, error)
              }
            }
            return { count: results.length, maxRelativeError: maximum, fields: 'all numeric simulation outputs' }
          }, { characterId, results: task.results })
        }
        await checkpoint()
        process.stderr.write(`${characterId} #${iteration}: ${task.outcome}, ${(task.elapsedMs / 1000).toFixed(2)}s, ${task.lastStatus.resultCount} results\n`)
        if (task.outcome !== 'completed') break
      }
    } catch (error) {
      report.errors.push({ characterId, error: String(error) })
      process.exitCode = 1
      await checkpoint()
      break
    } finally {
      await browser.close()
    }
  }
} finally {
  await checkpoint()
  await new Promise<void>((resolve, reject) => server.httpServer.close((error) => error ? reject(error) : resolve()))
}
